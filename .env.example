# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5434/rag
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Embeddings ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_RETRIES=3

# --- Chunking ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Generation (LLM) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# --- Retrieval / context construction ---
DEFAULT_TOP_K=5
CONTEXT_MAX_TOKENS=3000

# --- Local inference (Ollama) + hybrid routing ---
# Requires Ollama running locally: `brew install ollama && ollama serve`,
# then `ollama pull llama3.2:1b` (or your preferred model).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2

# Off by default. When true: non-sensitive requests go to the API provider
# (LLM_PROVIDER/LLM_MODEL above), sensitive requests go to Ollama, and a
# sensitive request hard-fails (never falls back to the API) if Ollama is
# unavailable. See app/providers/llm/router.py.
HYBRID_ROUTING_ENABLED=false
HYBRID_ALLOW_API_TO_LOCAL_FALLBACK=true

# --- Reranking ---
# Requires: pip install -e ".[rerank]"  (pulls in sentence-transformers/torch)
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_MULTIPLIER=4

# --- Observability ---
# Leave both blank to use LoggingTracer (logs spans locally, no external
# service needed) instead of Langfuse.
#
# To connect to Langfuse Cloud: create a project at https://cloud.langfuse.com
# (EU region) or https://us.cloud.langfuse.com (US region), then Settings ->
# API Keys to generate a public/secret keypair. LANGFUSE_HOST must match
# whichever region you picked.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Deployment hardening (Phase 7) ---
# All off/permissive by default for local dev. See DEPLOYMENT.md for the
# full checklist of what MUST be set before a public deployment —
# APP_ENV=production refuses to boot (see app/core/config.py's
# validate_production_config) unless these are set safely.
API_AUTH_ENABLED=false
API_KEYS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_MB=20
CORS_ALLOWED_ORIGINS=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
